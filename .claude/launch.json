{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "workspace",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080", "-d", "docs"],
      "port": 8080
    },
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m", "streamlit", "run", "app.py",
        "--server.port", "8501",
        "--server.headless", "true",
        "--browser.gatherUsageStats", "false"
      ],
      "port": 8501
    }
  ]
}
