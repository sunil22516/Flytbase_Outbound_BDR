# Copy to .env and fill in. Both providers are free tiers, no credit card.

# Grounded research + real citation URLs -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email drafting + critic loop -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Run shape (optional)
TARGET_ACCOUNTS=8
CONTACTS_PER_ACCOUNT=2
CRITIC_PASS_MARK=7.5
MAX_REVISIONS=1
